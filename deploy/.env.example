# Copy to deploy/.env (read by `docker compose -f deploy/compose.yaml`, separate from the dev .env).

PORTAL_DOMAIN=pilot.dev.isnan.me

# Certificate: internal (Caddy's local CA, browsers warn until its root is trusted) or cloudflare.
PORTAL_TLS=internal

# For PORTAL_TLS=cloudflare: API token with Zone › DNS › Edit on isnan.me (DNS-01 challenge).
CLOUDFLARE_API_TOKEN=

# Fixed sign-in code (8 letters/digits). Unset: generated at startup, see `docker compose logs portal`.
PORTAL_SERVER_CODE=

# NODE_AUTH_TOKEN (GitHub Packages, read:packages) is needed only to build; pass it from the shell:
#   NODE_AUTH_TOKEN=$(gh auth token) docker compose -f deploy/compose.yaml up -d --build
