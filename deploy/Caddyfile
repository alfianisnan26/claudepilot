# pilot.dev.isnan.me on the owner's Mac: a second address for the k3s portal (pilot.ai.isnan.me), so the database, sessions and
# workspaces are the cluster's. No portal runs here.
# PORTAL_TLS picks how the certificate is made:
#   internal   - Caddy's own local CA (default). Browsers warn until they trust Caddy's root certificate.
#   cloudflare - Let's Encrypt through a DNS-01 challenge; needs CLOUDFLARE_API_TOKEN (DNS edit on the zone).
(tls_internal) {
	tls internal
}

(tls_cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Ask public resolvers: the local DNS points the name here and may not serve the TXT record.
		resolvers 1.1.1.1 1.0.0.1
	}
}

{$PORTAL_DOMAIN} {
	import tls_{$PORTAL_TLS:internal}
	encode zstd gzip
	# The cluster's Traefik serves *.pilot.ai.isnan.me, so the TLS name is that one; the Host stays this domain, which the
	# IngressRoute also matches (deploy/k3s/portal.yaml) and the portal's same-host Origin check needs. WebSockets pass through.
	reverse_proxy https://{$PORTAL_UPSTREAM:192.168.100.5}:443 {
		header_up Host {host}
		transport http {
			tls_server_name pilot.ai.isnan.me
		}
	}
}
