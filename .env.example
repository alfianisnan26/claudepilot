# Server code used to sign in. Leave unset to generate one at startup (printed in the server log).
# Exactly 8 letters/digits. Case, spaces and dashes are ignored when signing in.
PORTAL_SERVER_CODE=

# Bind address and port.
PORTAL_HOST=0.0.0.0
PORTAL_PORT=3000

# Where the portal keeps its database and backups (default: .data at the repo root).
# PORTAL_DATA_DIR=

# Encrypts stored secrets: 32 random bytes, base64url (`npm run portal -- generate-key`).
# Prefer PORTAL_SECRET_KEY_FILE pointing outside the repo; never keep the key next to the data.
# PORTAL_SECRET_KEY_FILE=
# PORTAL_SECRET_KEY=
