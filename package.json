{
  "name": "claudepilot",
  "private": true,
  "type": "module",
  "description": "Portal: React + Vite frontend and Node backend served together on one port",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w @portal/server",
    "build": "npm run build -w @portal/web && npm run build -w @portal/server",
    "start": "npm run start -w @portal/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "portal": "npm run portal -w @portal/server --"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.2"
  }
}
