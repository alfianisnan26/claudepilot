{
  "extends": "@isnanme/tsconfig/base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "test"],
  // The G6 spike (PILOT-1159) imports apps/server's tunnel code, which needs @types/node (Buffer, NodeJS.Timeout, node:stream); those
  // modules are typechecked by the server's tsconfig, the spike's two test files are not typechecked (vitest runs them).
  "exclude": ["test/spike"]
}
