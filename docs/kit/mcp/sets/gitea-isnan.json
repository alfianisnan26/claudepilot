{
  "slug": "gitea-isnan",
  "servers": [
    {
      "key": "isnan",
      "entry": "@git-host-gitea",
      "version": "@approved",
      "enabled": true,
      "config": {
        "GITEA_HOST": "https://git.isnan.me"
      },
      "secrets": {
        "GITEA_ACCESS_TOKEN_FILE": "{{secret-file:GITEA_ISNAN_TOKEN}}"
      }
    }
  ]
}
