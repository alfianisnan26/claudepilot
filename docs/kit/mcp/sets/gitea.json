{
  "slug": "gitea",
  "servers": [
    {
      "key": "isnan",
      "entry": "@git-host-gitea",
      "version": "@approved",
      "enabled": true,
      "config": {
        "GITEA_HOST": "https://git.isnan.me",
        "GITEA_READONLY": "true"
      },
      "secrets": {
        "GITEA_ACCESS_TOKEN_FILE": "{{secret-file:GITEA_ISNAN_TOKEN}}"
      }
    },
    {
      "key": "konfersi",
      "entry": "@git-host-gitea",
      "version": "@approved",
      "enabled": true,
      "config": {
        "GITEA_HOST": "https://git.konfersi.com",
        "GITEA_READONLY": "true"
      },
      "secrets": {
        "GITEA_ACCESS_TOKEN_FILE": "{{secret-file:GITEA_KONFERSI_TOKEN}}"
      }
    },
    {
      "key": "kohilabs",
      "entry": "@git-host-gitea",
      "version": "@approved",
      "enabled": true,
      "config": {
        "GITEA_HOST": "https://git.kohi-labs.com",
        "GITEA_READONLY": "true"
      },
      "secrets": {
        "GITEA_ACCESS_TOKEN_FILE": "{{secret-file:GITEA_KOHILABS_TOKEN}}"
      }
    }
  ]
}
